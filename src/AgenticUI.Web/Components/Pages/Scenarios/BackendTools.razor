@page "/backend-tools"
@inject AgentServerConnection Agents
@inject ILoggerFactory LoggerFactory
@implements IDisposable

<PageTitle>Backend tools</PageTitle>

<div class="scenario">
    <div class="scenario__intro">
        <h1>Backend tools</h1>
        <p>
            The agent calls a <strong>server-side</strong> tool (<code>get_weather</code>). The tool
            runs on the agent server; its call and result stream to the browser as AG-UI
            <code>TOOL_CALL_*</code> events. A generated, strongly typed <code>WeatherToolBlock</code>
            turns the <code>get_weather</code> invocation into a weather card instead of raw JSON.
        </p>
    </div>

    <div class="scenario__chat">
        <ChatPage Agent="_agent" Placeholder="Ask for the weather in a city…">
            <MessageListContent>
                <BlockRenderer TBlock="WeatherToolBlock"
                               Context="weather"
                               When="@(block => block.ToolName == "get_weather")">
                    <WeatherCard Block="weather" />
                </BlockRenderer>
            </MessageListContent>
        </ChatPage>
    </div>
</div>

@code {
    private UIAgent _agent = default!;
    private IChatClient _chatClient = default!;

    protected override void OnInitialized()
    {
        _chatClient = Agents.CreateChatClient("/backend_tool_rendering");
        _agent = new UIAgent(
            _chatClient,
            options => options.AddGeneratedToolBlocks(),
            LoggerFactory);
    }

    public void Dispose()
    {
        _agent?.Dispose();
        (_chatClient as IDisposable)?.Dispose();
    }
}
