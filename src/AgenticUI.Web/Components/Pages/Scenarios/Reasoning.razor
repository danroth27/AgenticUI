@page "/reasoning"
@inject AgentServerConnection Agents
@implements IDisposable

<PageTitle>Reasoning</PageTitle>

<div class="scenario">
    <div class="scenario__intro">
        <h1>Reasoning</h1>
        <p>
            A reasoning model (GPT-5 mini on Microsoft Foundry) returns a summary of its reasoning through
            the OpenAI Responses API. Microsoft.Extensions.AI surfaces the summary as
            <code>TextReasoningContent</code>, the server re-emits it as AG-UI
            <code>REASONING_*</code> events, and the Blazor AI components render it as a collapsible
            <em>"reasoning summary"</em> panel, separate from the final answer.
            Try: <em>"A farmer needs to get a fox, a chicken, and a sack of grain across a river. The boat holds the farmer and one item. The fox eats the chicken if left alone with it, and the chicken eats the grain. Work out the full sequence of crossings."</em>
        </p>
        <p class="scenario__note">Note: reasoning models are slower — give it a few seconds.</p>
    </div>

    <div class="scenario__chat">
        <ChatPage Agent="_agent" Placeholder="Ask a question that needs some thought…">
            <MessageListContent>
                <BlockRenderer TBlock="ReasoningActivityBlock" Context="reasoning">
                    <ReasoningCard Block="reasoning" />
                </BlockRenderer>
            </MessageListContent>
        </ChatPage>
    </div>
</div>

@code {
    private UIAgent _agent = default!;
    private IChatClient _chatClient = default!;

    protected override void OnInitialized()
    {
        _chatClient = Agents.CreateChatClient("/reasoning");
        _agent = new UIAgent(_chatClient, options =>
            options.AddBlockHandler(new ReasoningActivityHandler()));
    }

    public void Dispose()
    {
        _agent?.Dispose();
        (_chatClient as IDisposable)?.Dispose();
    }
}
