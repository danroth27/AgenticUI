@page "/frontend-tools"
@inject AgentServerConnection Agents
@implements IDisposable

<PageTitle>Frontend tools</PageTitle>

<div class="scenario">
    <div class="scenario__intro">
        <h1>Frontend tools</h1>
        <p>
            A <strong>client-side</strong> tool runs in the Blazor app, not on the agent server. We add
            <code>set_accent_color</code> to <code>ChatOptions.Tools</code>; the model calls it and the
            AG-UI client executes it locally to restyle this page. Try:
            <em>"Change the accent color to rebeccapurple."</em>
        </p>
    </div>

    <div class="scenario__split">
        <aside class="scenario__panel">
            <div class="panel-card">
                <div class="swatch" style="background: @_accent;"></div>
                <div class="swatch-label">Current accent: <code>@_accent</code></div>
            </div>
        </aside>
        <div class="scenario__chat">
            <ChatPage Agent="_agent" Placeholder="Ask me to change the accent color…">
                <MessageListContent>
                    <BlockRenderer TBlock="AccentColorToolBlock"
                                   When='block => block.ToolName == "set_accent_color"'
                                   Context="block">
                        <div class="ui-action-chip">
                            @if (block.HasResult)
                            {
                                <text>🎨 ran <code>@block.ToolName</code> in the Blazor app</text>
                            }
                            else
                            {
                                <text>🎨 running <code>@block.ToolName</code> in the Blazor app…</text>
                            }
                        </div>
                    </BlockRenderer>
                </MessageListContent>
            </ChatPage>
        </div>
    </div>
</div>

@code {
    private UIAgent _agent = default!;
    private IChatClient _chatClient = default!;
    private string _accent = "#512bd4";

    protected override void OnInitialized()
    {
        _chatClient = Agents.CreateChatClient("/tool_based_generative_ui");

        var setAccentColor = AIFunctionFactory.Create(
            async (string color) =>
            {
                await InvokeAsync(() =>
                {
                    _accent = color;
                    StateHasChanged();
                });
                return $"Accent color set to {color}.";
            },
            name: "set_accent_color",
            description: "Set the accent color of the page. Accepts any CSS color (name or hex).");

        _agent = new UIAgent(_chatClient, options =>
        {
            options.ChatOptions = new ChatOptions { Tools = [setAccentColor] };
            options.AddGeneratedToolBlocks();
        });
    }

    public void Dispose()
    {
        _agent.Dispose();
        (_chatClient as IDisposable)?.Dispose();
    }
}
