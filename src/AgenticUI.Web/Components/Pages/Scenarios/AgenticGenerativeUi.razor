@page "/agentic-generative-ui"
@inject AgentServerConnection Agents
@implements IDisposable
@using System.Text.Json

<PageTitle>Agentic generative UI</PageTitle>

<div class="scenario">
    <div class="scenario__intro">
        <h1>Agentic generative UI</h1>
        <p>
            The agent plans work with the <code>create_plan</code> tool (an AG-UI
            <code>STATE_SNAPSHOT</code>) and advances each step with <code>update_plan_step</code> (an AG-UI
            <code>STATE_DELTA</code> / JSON Patch). The UI renders live plan progress. Try:
            <em>"Plan a weekend trip to Seattle."</em>
        </p>
    </div>

    <div class="scenario__split">
        <aside class="scenario__panel">
            <div class="panel-card">
                @if (_agent.State.Value.Steps.Count == 0)
                {
                    <div class="panel-empty">The plan will appear here, updating as the agent works.</div>
                }
                else
                {
                    <ol class="plan">
                        @foreach (var step in _agent.State.Value.Steps)
                        {
                            var done = string.Equals(step.Status, "completed", StringComparison.OrdinalIgnoreCase);
                            <li class="plan__step @(done ? "plan__step--done" : "")">
                                <span class="plan__marker">@(done ? "✓" : "○")</span>
                                <span class="plan__text">@step.Description</span>
                            </li>
                        }
                    </ol>
                }
            </div>
        </aside>
        <div class="scenario__chat">
            <ChatPage Agent="_agent" Placeholder="Ask me to plan something…" />
        </div>
    </div>
</div>

@code {
    private UIAgent<PlanState> _agent = default!;
    private IChatClient _chatClient = default!;
    private IDisposable? _stateChangedSubscription;

    protected override void OnInitialized()
    {
        _chatClient = Agents.CreateChatClient("/agentic_generative_ui");
        _agent = new UIAgent<PlanState>(_chatClient, options =>
        {
            options.StateMapper = ctx =>
            {
                switch (ctx.Update.RawRepresentation)
                {
                    case StateSnapshotEvent snapshot
                        when snapshot.Snapshot.Deserialize<PlanState>() is { } state:
                        ctx.SetState(state);
                        break;
                    case StateDeltaEvent delta:
                        ctx.SetState(ApplyDelta(_agent.State.Value, delta.Delta));
                        break;
                }
            };
        });
        _stateChangedSubscription = _agent.State.OnChanged(() => InvokeAsync(StateHasChanged));
    }

    private static PlanState ApplyDelta(PlanState current, JsonElement delta)
    {
        if (delta.ValueKind != JsonValueKind.Array)
        {
            throw new InvalidOperationException("The plan state delta must be a JSON Patch array.");
        }

        var next = new PlanState
        {
            Steps = [.. current.Steps.Select(step => new PlanStep
            {
                Description = step.Description,
                Status = step.Status
            })]
        };

        foreach (var operation in delta.EnumerateArray())
        {
            string op = operation.GetProperty("op").GetString()
                ?? throw new InvalidOperationException("The plan state operation is missing an op.");
            string path = operation.GetProperty("path").GetString()
                ?? throw new InvalidOperationException("The plan state operation is missing a path.");

            string[] segments = path.TrimStart('/').Split('/');
            if (op != "replace" ||
                segments is not ["steps", var indexText, var property] ||
                !int.TryParse(indexText, out int index) ||
                index < 0 ||
                index >= next.Steps.Count)
            {
                throw new InvalidOperationException($"Unsupported plan state operation: {op} {path}.");
            }

            string value = operation.GetProperty("value").GetString()
                ?? throw new InvalidOperationException($"The plan state operation {path} requires a string value.");

            switch (property)
            {
                case "description":
                    next.Steps[index].Description = value;
                    break;
                case "status":
                    next.Steps[index].Status = value;
                    break;
                default:
                    throw new InvalidOperationException($"Unsupported plan state path: {path}.");
            }
        }

        return next;
    }

    public void Dispose()
    {
        _stateChangedSubscription?.Dispose();
        _agent.Dispose();
        (_chatClient as IDisposable)?.Dispose();
    }
}
