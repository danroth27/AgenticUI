@page "/shared-state"
@inject AgentServerConnection Agents
@inject ConversationThreadStore Threads
@implements IDisposable
@using System.Text.Json

<PageTitle>Shared state</PageTitle>

<div class="scenario">
    <div class="scenario__intro">
        <h1>Shared state</h1>
        <p>
            Edit the structured recipe yourself or ask the agent to improve it. Local changes are sent
            with the next request, and agent changes return as AG-UI <code>STATE_SNAPSHOT</code> events
            mapped into a strongly typed <code>UIAgent&lt;RecipeState&gt;</code>. Try changing an
            ingredient, then ask: <em>"Make this recipe vegan."</em>
        </p>
    </div>

    <div class="scenario__split">
        <aside class="scenario__panel">
            <RecipeEditor Recipe="_agent.State.Value.Recipe"
                          RecipeChanged="HandleRecipeChanged" />
        </aside>
        <div class="scenario__chat">
            <ChatPage Agent="_agent" Placeholder="Ask for a recipe…" />
        </div>
    </div>
</div>

@code {
    private static readonly JsonSerializerOptions s_jsonOptions = new(JsonSerializerDefaults.Web);

    private UIAgent<RecipeState> _agent = default!;
    private IChatClient _chatClient = default!;
    private IDisposable? _stateChangedSubscription;

    protected override void OnInitialized()
    {
        var thread = Threads.Get("shared-state");
        _chatClient = Agents.CreateChatClient("/shared_state");
        _agent = new UIAgent<RecipeState>(_chatClient, options =>
        {
            options.Thread = thread;
            options.ChatOptions = new ChatOptions
            {
                RawRepresentationFactory = _ => new RunAgentInput
                {
                    ThreadId = thread.ThreadId,
                    State = JsonSerializer.SerializeToElement(_agent.State.Value, s_jsonOptions),
                },
            };
            options.StateMapper = ctx =>
            {
                if (ctx.Update.RawRepresentation is StateSnapshotEvent snapshot &&
                    snapshot.Snapshot.Deserialize<RecipeState>(s_jsonOptions) is { } state)
                {
                    ctx.SetState(state);
                }
            };
        }, CreateDefaultState());
        _stateChangedSubscription = _agent.State.OnChanged(() => InvokeAsync(StateHasChanged));
    }

    private void HandleRecipeChanged(Recipe recipe) =>
        _agent.State.Value = new RecipeState { Recipe = recipe };

    private static RecipeState CreateDefaultState() => new()
    {
        Recipe = new Recipe
        {
            Title = "Creamy Tomato Pasta",
            SkillLevel = "Beginner",
            CookingTime = "30 min",
            SpecialPreferences = ["Vegetarian"],
            Ingredients =
            [
                new Ingredient { Icon = "🍝", Name = "Pasta", Amount = "12 oz" },
                new Ingredient { Icon = "🍅", Name = "Crushed tomatoes", Amount = "1 can" },
                new Ingredient { Icon = "🥛", Name = "Heavy cream", Amount = "1/2 cup" },
                new Ingredient { Icon = "🧀", Name = "Parmesan", Amount = "1/2 cup" },
                new Ingredient { Icon = "🌿", Name = "Fresh basil", Amount = "1 handful" },
            ],
            Instructions =
            [
                "Cook the pasta until al dente.",
                "Simmer the tomatoes and cream for 10 minutes.",
                "Toss the pasta with the sauce and Parmesan.",
                "Finish with fresh basil and serve.",
            ],
        },
    };

    public void Dispose()
    {
        _stateChangedSubscription?.Dispose();
        _agent.Dispose();
        (_chatClient as IDisposable)?.Dispose();
    }
}
