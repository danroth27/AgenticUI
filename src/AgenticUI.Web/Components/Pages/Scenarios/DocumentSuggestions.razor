<div class="document-suggestions">
    <button disabled="@Disabled"
            @onclick='() => SelectAsync("Please write a short story about a pirate named Candy Beard.")'>
        Pirate story
    </button>
    <button disabled="@Disabled"
            @onclick='() => SelectAsync("Please write a short story about a mermaid named Luna.")'>
        Mermaid story
    </button>
    <button disabled="@Disabled"
            @onclick='() => SelectAsync("Please add a character named Courage.")'>
        Add character
    </button>
</div>

@code {
    [Parameter]
    public bool Disabled { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> SuggestionSelected { get; set; }

    private Task SelectAsync(string prompt) => SuggestionSelected.InvokeAsync(prompt);
}
