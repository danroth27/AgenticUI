<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep experimental OpenAI API diagnostics visible without blocking the build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);OPENAI001</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgenticUI.ServiceDefaults\AgenticUI.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MAF AG-UI server hosting (still in preview) layered over the AG-UI C# SDK -->
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="1.26.0-preview.261023.1" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.26.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.26.0" />
    <!-- AG-UI C# SDK (released by the AG-UI team) -->
    <PackageReference Include="AGUI.Server" Version="1.0.1" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

</Project>
